{
  "name": "ForbiddenAPI",
  "tree": {

    "$className": "DataModel",
    
    "ReplicatedStorage": {

      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Forbidden": {
        "$path": "src/Forbidden"
      }

    }
  },
  "globIgnorePaths": [
    "src/**/compile_exclude"
  ]
}