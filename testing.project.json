{
  "name": "ForbiddenAPI",
  "tree": {

    "$className": "DataModel",

    "Workspace": {
      "$className": "Workspace",
      "Rig": {
        "$className": "Model",
        "ChaseAIBase": {
          "$path": "src/Forbidden/AI/precoded/ChaseAI/ChaseAIBase/ChaseAIBase",
          "Settings": {
            "$path": "src/Forbidden/AI/precoded/ChaseAI/ChaseAIBase/compile_exclude/TestSettings.luau",
            "$ignoreUnknownInstances": true
          },
          "Hooks": {
            "$path": "src/Forbidden/AI/precoded/ChaseAI/ChaseAIBase/ChaseAIBase/Hooks",
            "$ignoreUnknownInstances": true,
            "Animations": {
              "$path": "src/Forbidden/AI/precoded/ChaseAI/ChaseAIBase/compile_exclude/TestAnimations",
              "$ignoreUnknownInstances": true,
              "Animate": {
                "$ignoreUnknownInstances": true,
                "$path": "src/Forbidden/AI/precoded/ChaseAI/ChaseAIBase/ChaseAIBase/Hooks/Animations/Animate"
              }
            }
          },
          "$ignoreUnknownInstances": true
        },
        "$ignoreUnknownInstances": true
      },
      "$ignoreUnknownInstances": true
    },
    
    "ReplicatedStorage": {

      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Forbidden": {
        "$path": "src/Forbidden"
      }

    }
  },
  "globIgnorePaths": [
    "src/**/compile_exclude",
    "src/Forbidden/AI/precoded/ChaseAI/**/Settings.luau",
    "src/**/Hooks",
    "src/**/Animations"
  ]
}